# Use the official lightweight Nginx image
FROM nginx:stable-alpine

# Remove the default Nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# 1. Copy the custom Nginx configuration file
# This file sets up the static file serving and the /ws/ proxy.
COPY nginx.conf /etc/nginx/nginx.conf

# 2. Copy all client-side assets to the default Nginx HTML directory
COPY startPageTemplate.html /usr/share/nginx/html/
COPY gamePageTemplate.html /usr/share/nginx/html/
COPY websocketstuff.js /usr/share/nginx/html/
COPY cardDeck.js /usr/share/nginx/html/

# 3. Assuming your cardDeck.js/gamePageTemplate.html use an 'images' directory, copy it
# If you don't have an 'images' directory, you can safely remove this line.
COPY images/ /usr/share/nginx/html/images/

# Port 80 is exposed by the base image, but it's good practice to list it.
EXPOSE 80